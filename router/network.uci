package network

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '00042e062446e2884d9e9ccabc588740854f'
	option ula_prefix 'fdcb:8dea:5a27::/48'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ip6assign '60'
	option ipaddr '10.0.1.1'
	option netmask '255.255.255.0'

config device 'v10'
	option type '8021q'
	option ifname 'eth0'
	option vid '10'
	option name 'eth0.10'

config interface 'wan'
	option device 'eth0.10'
	option proto 'dhcp'

config device 'v20'
	option type '8021q'
	option ifname 'eth0'
	option vid '20'
	option name 'eth0.20'

config interface 'servers'
	option proto 'static'
	option ipaddr '10.0.20.1'
	option netmask '255.255.255.0'
	option device 'eth0.20'

